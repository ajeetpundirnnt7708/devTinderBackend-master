# DevTinder API — environment example
# Copy this file to src/.env and replace the values.

PORT=3000
NODE_ENV=development

# Percent-encode special characters in the password (@ -> %40).
DATABASE_URL=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/devTinder?retryWrites=true&w=majority

# 64 random hex characters
JWT_SECRET=change_me

# Comma separated list of frontend origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:5173,https://dev-tinder.site
